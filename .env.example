# Copy this file to ".env" and fill in values. NEVER commit the real .env file.
# Leave AI_API_KEY empty to run with static analysis only (no AI).

# Which AI provider to use: gemini, anthropic or openai
AI_PROVIDER=gemini

# Your secret API key from the provider's website
AI_API_KEY=

# Optional: model name. Leave empty to use the default for the provider.
AI_MODEL=

# Set to true to disable external AI completely, even if a key exists
DISABLE_AI=false
